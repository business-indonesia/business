# ==============================================================================
# ENVIRONMENT CONFIGURATION - GENERATEDURLTOAPKAAB
# Target Production: https://generated.business.web.id
# ==============================================================================

# Node runtime environment (development, test, production)
NODE_ENV=development

# Application HTTP Port
PORT=3000

# Public Canonical URL of the platform
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# DATABASE (PostgreSQL)
# ------------------------------------------------------------------------------
# Format: postgresql://[USER]:[PASSWORD]@[HOST]:[PORT]/[DATABASE]?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/generatedurltoapkaab_dev?schema=public"
DATABASE_URL_TEST="postgresql://postgres:postgres@localhost:5432/generatedurltoapkaab_test?schema=public"

# ------------------------------------------------------------------------------
# BACKGROUND QUEUE & REDIS
# ------------------------------------------------------------------------------
# Redis connection URL for BullMQ job queue distribution
REDIS_URL="redis://localhost:6379"

# ------------------------------------------------------------------------------
# SECURITY & AUTHENTICATION
# ------------------------------------------------------------------------------
# 32+ character high-entropy secret key for session/JWT encryption
# Generate via: openssl rand -base64 32
AUTH_SECRET="change-this-to-a-very-secure-random-32-byte-secret"

# Keystore encryption key for securing uploaded/generated Android signing keys
KEYSTORE_ENCRYPTION_KEY="change-this-keystore-encryption-secret-32b"

# ------------------------------------------------------------------------------
# ARTIFACT & STORAGE MANAGEMENT
# ------------------------------------------------------------------------------
# Storage driver mode: 'local' (filesystem volume) or 's3' (AWS S3 / MinIO)
STORAGE_DRIVER=local

# Local storage base path for APK/AAB outputs and logs
STORAGE_LOCAL_PATH="./storage/artifacts"

# Optional S3-compatible configuration (Used when STORAGE_DRIVER=s3)
S3_ENDPOINT=""
S3_REGION="us-east-1"
S3_BUCKET="apkaab-artifacts"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_FORCE_PATH_STYLE="false"

# ------------------------------------------------------------------------------
# ANDROID BUILD WORKER (Used by workers/build-worker)
# ------------------------------------------------------------------------------
# Path to Android SDK root directory (in isolated worker container or local host)
ANDROID_SDK_ROOT="/opt/android-sdk"

# Path to OpenJDK 17 directory
JAVA_HOME="/usr/lib/jvm/java-17-openjdk"

# Maximum concurrent Android Gradle builds on this worker instance
WORKER_CONCURRENCY=2

# Maximum build timeout in milliseconds (e.g. 15 minutes = 900000)
BUILD_TIMEOUT_MS=900000
