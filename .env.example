# ==============================================================================
# Generated App Configuration
# ==============================================================================

# Application Details
APP_NAME=Generated App
APP_URL=https://generated.business.web.id
PORT=3000
HOST=0.0.0.0

# Security & Secrets
SECRET_KEY=change_this_to_a_random_secure_secret_string

# Default Administrator Credentials (auto-seeded on first run)
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME

# Build & File Limits
BUILD_TIMEOUT=600
MAX_FILE_SIZE=2097152

# Build Engine Settings
# 'local' uses the host's installed OpenJDK & Android SDK/Gradle.
# 'remote' delegates build requests to a remote build webhook if configured.
BUILD_ENGINE=local
REMOTE_BUILD_URL=

# Android SDK & Java paths (optional, auto-detected if in standard paths)
ANDROID_HOME=
JAVA_HOME=
