# Environment variables
.env
.env*.local

# Python cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/

# Node (if used)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Android build outputs & Keystores (MUST NOT BE COMMITTED)
*.apk
*.aab
*.jks
*.keystore
.gradle/
build/
app/build/
android-template/build/
android-template/app/build/
android-template/.gradle/

# Temporary and log files
tmp/
logs/
*.log
.DS_Store

# User storage generated artifacts
storage/users/*
!storage/users/.gitkeep
storage/*.db
storage/*.sqlite
storage/*.sqlite3
!storage/.gitkeep

# Archive deliverables
*.zip
*.tar.gz
