generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum BuildType {
  APK
  AAB
  BOTH
}

enum BuildStatus {
  PENDING
  QUEUED
  IN_PROGRESS
  COMPLETED
  FAILED
  CANCELLED
}

enum ArtifactType {
  APK_DEBUG
  APK_RELEASE
  AAB_RELEASE
  KEYSTORE
  LOG_BUNDLE
}

enum LogLevel {
  DEBUG
  INFO
  WARN
  ERROR
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String?
  passwordHash String
  role         UserRole  @default(USER)
  projects     Project[]
  builds       Build[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("users")
}

model Project {
  id           String   @id @default(cuid())
  name         String
  appName      String
  packageId    String
  webUrl       String
  iconUrl      String?
  primaryColor String?  @default("#1E40AF")
  splashColor  String?  @default("#FFFFFF")
  appVersion   String   @default("1.0.0")
  versionCode  Int      @default(1)
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  builds       Build[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
  @@index([packageId])
  @@map("projects")
}

model Build {
  id           String      @id @default(cuid())
  projectId    String
  project      Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  buildType    BuildType
  status       BuildStatus @default(PENDING)
  progress     Int         @default(0)
  errorMessage String?
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  artifacts    Artifact[]
  logs         BuildLog[]

  @@index([projectId])
  @@index([userId])
  @@index([status])
  @@map("builds")
}

model Artifact {
  id             String       @id @default(cuid())
  buildId        String
  build          Build        @relation(fields: [buildId], references: [id], onDelete: Cascade)
  artifactType   ArtifactType
  fileName       String
  filePath       String
  fileSize       Int?
  mimeType       String
  checksumSha256 String?
  downloadUrl    String?
  expiresAt      DateTime?
  createdAt      DateTime     @default(now())

  @@index([buildId])
  @@map("artifacts")
}

model BuildLog {
  id        String   @id @default(cuid())
  buildId   String
  build     Build    @relation(fields: [buildId], references: [id], onDelete: Cascade)
  level     LogLevel @default(INFO)
  stage     String
  message   String
  timestamp DateTime @default(now())

  @@index([buildId])
  @@index([timestamp])
  @@map("build_logs")
}
